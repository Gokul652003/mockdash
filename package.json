{
  "name": "mockdash",
  "version": "1.0.0",
  "description": "Linux mock server desktop app with sidebar",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux",
    "dist:deb": "electron-builder --linux deb",
    "dist:appimage": "electron-builder --linux AppImage"
  },
  "author": "Gokul K R",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gokulkr.mockdash",
    "productName": "MockDash",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "renderer/**/*",
      "build/icon.png",
      "build/icons/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "Development",
      "maintainer": "Gokul KR <gokulkr652003@gmail.com>"
    }
  }
}